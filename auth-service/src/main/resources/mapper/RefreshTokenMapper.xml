<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.prasac.authservice.mapper.RefreshTokenMapper">

    <resultMap id="RefreshTokenResultMap" type="com.prasac.authservice.entity.RefreshToken">
        <id column="id" property="id" javaType="java.lang.Long" />
        <result column="user_id" property="userId" javaType="java.lang.Long" />
        <result column="token" property="token" javaType="java.lang.String" />
        <result column="expires_at" property="expiresAt" javaType="java.time.LocalDateTime" />
        <result column="revoked" property="revoked" javaType="java.lang.Boolean" />
        <result column="created_at" property="createdAt" javaType="java.time.LocalDateTime" />
        <result column="updated_at" property="updatedAt" javaType="java.time.LocalDateTime" />
    </resultMap>

    <select id="selectByToken" parameterType="java.lang.String" resultMap="RefreshTokenResultMap">
        SELECT id, user_id, token, expires_at, revoked, created_at, updated_at
        FROM refresh_tokens
        WHERE token = #{token}
    </select>

    <insert id="insert" parameterType="com.prasac.authservice.entity.RefreshToken" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO refresh_tokens (user_id, token, expires_at, revoked, created_at, updated_at)
        VALUES (#{userId}, #{token}, #{expiresAt}, #{revoked}, NOW(), NOW())
    </insert>

    <update id="revokeByToken" parameterType="java.lang.String">
        UPDATE refresh_tokens
        SET revoked = true,
            updated_at = NOW()
        WHERE token = #{token}
    </update>

    <update id="revokeAllByUserId" parameterType="java.lang.Long">
        UPDATE refresh_tokens
        SET revoked = true,
            updated_at = NOW()
        WHERE user_id = #{userId}
          AND revoked = false
    </update>

</mapper>
